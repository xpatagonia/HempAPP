# 1. Base de Datos Cloud (Supabase PostgreSQL)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 2. Notificaciones Oficiales en Vercel Serverless + Resend.com (HTTPS:443)
# Configurar RESEND_API_KEY en Vercel Dashboard -> Settings -> Environment Variables
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="HempC Nucleus <notificaciones@hempc.com.ar>"

# 3. Motor Python de Telemetría IoT, Sensores LoRaWAN y Modelado IA (Render)
VITE_TELEMETRY_API_URL=https://hempapp.onrender.com
VITE_TELEMETRY_WS_URL=wss://hempapp.onrender.com

# 4. IA Generativa / Asistencia Agronómica (Opcional)
GEMINI_API_KEY=
